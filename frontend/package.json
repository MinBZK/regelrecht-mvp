{
  "name": "regelrecht-ui-prototype",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "wasm:build": "just wasm-build",
    "prebuild": "node scripts/copy-laws.js",
    "predev": "node ../bdd/codegen/gen-js.mjs && node scripts/copy-laws.js",
    "dev": "vite",
    "build": "vite build && node scripts/check-first-load.mjs dist && node scripts/precompress.mjs dist",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "pretest": "node ../bdd/codegen/gen-js.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "nldd:imports": "node ../script/check-nldd-imports.mjs src src/nldd-components.js --write",
    "nldd:check": "node ../script/check-nldd-imports.mjs src src/nldd-components.js"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@nldd/design-system": "^0.9.0",
    "@regelrecht/frontend-shared": "*",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.0",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
