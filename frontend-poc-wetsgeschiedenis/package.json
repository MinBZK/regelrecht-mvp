{
  "name": "poc-wetsgeschiedenis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PoC: de Kamerstukken van een wetsvoorstel handeling voor handeling afgespeeld op de wettekst, met de toelichting per artikel, en een geldende wet versie voor versie door de tijd",
  "scripts": {
    "predev": "node scripts/copy-assets.js",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.js",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "node scripts/copy-assets.js",
    "test": "vitest run",
    "nldd:imports": "node ../script/check-nldd-imports.mjs src src/nldd-components.js --write",
    "nldd:check": "node ../script/check-nldd-imports.mjs src src/nldd-components.js"
  },
  "dependencies": {
    "@nldd/design-system": "^0.9.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
