---
/*
 * "Rules as Executed" position paper, rendered in full. Everything under
 * src/research/rules-as-executed.* is generated from the paper's LaTeX source
 * by convert-html.py (pandoc + citeproc; glossary first-use expansion,
 * numbered sections), which lives next to that source in the research
 * repository: the body HTML, the outline headings, and the meta JSON with
 * title, authors, date and DOI that this page, the research index and the
 * landing tile all read. This page only supplies the byline and the "since
 * publication" note; ResearchPaper is the shell. The typeset PDF is archived
 * on Zenodo under the DOI and is the authoritative version; the button links
 * there.
 */
import Base from '~/layouts/Base.astro';
import ResearchPaper from '~/components/ResearchPaper.astro';
import paperHtml from '~/research/rules-as-executed.html?raw';
import headings from '~/research/rules-as-executed.headings.json';
import meta from '~/research/rules-as-executed.meta.json';

const pathname = '/research/rules-as-executed';
const title = `${meta.title} · RegelRecht`;
const authors = meta.authors.join(' and ');
const description =
  `${meta.kind} by ${authors}: publish law execution as machine-executable ` +
  'specifications, so that decisions can be re-executed and rules analyzed.';
const doiUrl = `https://doi.org/${meta.doi}`;
---

<Base
  lang="en"
  kind="docs"
  pathname={pathname}
  title={title}
  description={description}
>
  <ResearchPaper
    title={meta.title}
    subtitle={meta.subtitle}
    pdfHref={doiUrl}
    pdfLabel="PDF on Zenodo"
    pdfExternal
    discussionExclude={['Citizen Explanation']}
    headings={headings}
    html={paperHtml}
  >
    <p>
      <strong>{authors}</strong><br />
      <em>{meta.affiliation}</em><br />
      {
        meta.emails.map((email, i) => (
          <Fragment>
            {i > 0 && ' · '}
            <a href={`mailto:${email}`}>{email}</a>
          </Fragment>
        ))
      }<br />
      {meta.kind}, {meta.date_display}<br />
      <a href={doiUrl}>doi:{meta.doi}</a>
    </p>
    <p><small>{meta.note}</small></p>
    {/*
     * The paper is frozen (see AGENTS.md, "Published papers are frozen"); this
     * note is where its divergence from the current code is recorded instead.
     * It sits outside the data-discuss-paper rich-text on purpose: it is the
     * site's text, not the authors', and a selection in it is not a passage of
     * the paper. It gives a few examples, not a changelog: the RFCs and the
     * schema version history are where changes are recorded. Never edit the
     * paper to match.
     */}
    <Fragment slot="note">
    <nldd-rich-text centered>
      <h2 id="since-publication">Since publication</h2>
      <p>
        This paper is published as written on {meta.date_display}, and it stays
        that way. The format and the engine have kept developing since, so the
        paper no longer describes their current state in full. The format now
        aggregates over collections with <code>FOREACH</code>
        (<a href="/rfcs/rfc-016">RFC-016</a>), untranslatables became
        <a href="/concepts/markings">markings</a>, which a discretionary
        provision no longer needs (<a href="/rfcs/rfc-031">RFC-031</a>), and the engine tells an absent
        value apart from an unknown one
        (<a href="/rfcs/rfc-036">RFC-036</a>). For the current design, read the
        <a href="/docs/">documentation</a> and the <a href="/rfcs/">RFCs</a>.
      </p>
    </nldd-rich-text>
    </Fragment>
  </ResearchPaper>
</Base>
