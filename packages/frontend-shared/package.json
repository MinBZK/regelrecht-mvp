{
  "name": "@regelrecht/frontend-shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared frontend primitives (auth, color scheme, API fetch, Gherkin runner, saved state) for the regelrecht Vue frontends",
  "exports": {
    ".": "./src/index.js",
    "./gherkin": "./src/gherkin/index.js",
    "./gherkin/*": "./src/gherkin/*",
    "./lib/*": "./src/lib/*",
    "./components/*": "./src/components/*",
    "./*.js": "./src/*.js",
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "echarts": "^6.1.0",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.2"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "vue-echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
